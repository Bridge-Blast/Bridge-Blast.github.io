{"name":"Blast Bridge","short_name":"Blast Bridge","description":"Blast Bridge is a non-custodial interface to move ETH and stablecoins between Ethereum and Blast. Connect your own wallet, review the quote and sign each step.","start_url":"/","display":"standalone","background_color":"#f6f6f1","theme_color":"#f6f6f1","icons":[{"src":"icon.svg","sizes":"any","type":"image/svg+xml"}]}